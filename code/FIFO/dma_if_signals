
// Module: dma_systolic_bridge
// Description: Standalone CDC Bridge encapsulating Async FIFOs and Systolic
//              Adapter Connects directly between dma.sv and systolic.sv.


module dma_systolic_bridge #(
    parameter int STREAM_WIDTH   = 4,
    parameter int MATRIX_SIZE    = 4,
    parameter int DATA_WIDTH     = 4,
    parameter int FIFO_DEPTH_EXP = 5   // Depth = 2^5 = 32 entries
)(

    // Interface 1: DMA Clock Domain (clk_dma)

    input  logic                    clk_dma,
    input  logic                    rst_dma_n,

    // MM2S Stream from DMA (Input to Bridge)
    input  logic [STREAM_WIDTH-1:0] dma_m_axis_tdata,
    input  logic                    dma_m_axis_tvalid,
    output logic                    dma_m_axis_tready,

    // S2MM Stream to DMA (Output from Bridge)
    output logic [STREAM_WIDTH-1:0] dma_s_axis_tdata,
    output logic                    dma_s_axis_tvalid,
    input  logic                    dma_s_axis_tready,


    // Interface 2: Systolic Array Clock Domain (clk_sys)

    input  logic                                           clk_sys,
    input  logic                                           rst_sys_n,

    // Controls and Data to/from Systolic Core
    output logic                                           sys_start,
    output logic [2*MATRIX_SIZE*MATRIX_SIZE*DATA_WIDTH-1:0] sys_input_data,
    input  logic [  MATRIX_SIZE*MATRIX_SIZE*DATA_WIDTH-1:0] sys_output_data,
    input  logic                                           sys_valid
);

    // FIFO Interconnect Wires (Systolic Clock Domain)
    logic [STREAM_WIDTH-1:0] tx_fifo_dout;
    logic                    tx_fifo_empty;
    logic                    tx_fifo_rd_en;
    logic                    tx_fifo_full;

    logic [STREAM_WIDTH-1:0] rx_fifo_din;
    logic                    rx_fifo_full;
    logic                    rx_fifo_wr_en;
    logic                    rx_fifo_empty;

    // DMA Side Ready/Valid to FIFO Full/Empty handshakes
    assign dma_m_axis_tready = ~tx_fifo_full;
    wire tx_wr_en            = dma_m_axis_tvalid && dma_m_axis_tready;

    assign dma_s_axis_tvalid = ~rx_fifo_empty;
    wire rx_rd_en            = dma_s_axis_tvalid && dma_s_axis_tready;

    // 1. TX Async FIFO: DMA (Write) -> Systolic Domain (Read)

    async_fifo #(
        .DATA_WIDTH(STREAM_WIDTH),
        .ADDR_WIDTH(FIFO_DEPTH_EXP)
    ) u_tx_async_fifo (
        .wr_clk  (clk_dma),
        .wr_rst_n(rst_dma_n),
        .wr_en   (tx_wr_en),
        .din     (dma_m_axis_tdata),
        .full    (tx_fifo_full),

        .rd_clk  (clk_sys),
        .rd_rst_n(rst_sys_n),
        .rd_en   (tx_fifo_rd_en),
        .dout    (tx_fifo_dout),
        .empty   (tx_fifo_empty)
    );

    // 2. RX Async FIFO: Systolic Domain (Write) -> DMA (Read)

    async_fifo #(
        .DATA_WIDTH(STREAM_WIDTH),
        .ADDR_WIDTH(FIFO_DEPTH_EXP)
    ) u_rx_async_fifo (
        .wr_clk  (clk_sys),
        .wr_rst_n(rst_sys_n),
        .wr_en   (rx_fifo_wr_en),
        .din     (rx_fifo_din),
        .full    (rx_fifo_full),

        .rd_clk  (clk_dma),
        .rd_rst_n(rst_dma_n),
        .rd_en   (rx_rd_en),
        .dout    (dma_s_axis_tdata),
        .empty   (rx_fifo_empty)
    );


    // 3. Systolic Domain Adapter Unit

    systolic_adapter #(
        .STREAM_WIDTH(STREAM_WIDTH),
        .MATRIX_SIZE (MATRIX_SIZE),
        .DATA_WIDTH  (DATA_WIDTH)
    ) u_systolic_adapter (
        .clk_sys        (clk_sys),
        .rst_sys_n      (rst_sys_n),

        .tx_fifo_dout   (tx_fifo_dout),
        .tx_fifo_empty  (tx_fifo_empty),
        .tx_fifo_rd_en  (tx_fifo_rd_en),

        .rx_fifo_din    (rx_fifo_din),
        .rx_fifo_full   (rx_fifo_full),
        .rx_fifo_wr_en  (rx_fifo_wr_en),

        .sys_start      (sys_start),
        .sys_input_data (sys_input_data),
        .sys_output_data(sys_output_data),
        .sys_valid      (sys_valid)
    );

endmodule
