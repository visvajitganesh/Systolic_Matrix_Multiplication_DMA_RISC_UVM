
// Module: systolic_adapter
// Description: Accumulates 4-bit FIFO streams into 128-bit matrices for the
//              systolic array, and serializes 64-bit outputs back to 4-bit FIFO.


module systolic_adapter #(
    parameter int STREAM_WIDTH = 4,
    parameter int MATRIX_SIZE  = 4,
    parameter int DATA_WIDTH   = 4
)(
    input  logic clk_sys,
    input  logic rst_sys_n, // Active-low reset


    // TX FIFO Interface (Read Port in clk_sys domain)
    input  logic [STREAM_WIDTH - 1:0] tx_fifo_dout,
    input  logic                      tx_fifo_empty,
    output logic                      tx_fifo_rd_en,


    // RX FIFO Interface (Write Port in clk_sys domain)
    output logic [STREAM_WIDTH - 1:0] rx_fifo_din,
    input  logic                      rx_fifo_full,
    output logic                      rx_fifo_wr_en,


    // Systolic Array Hardware Interface
    output logic                                                    sys_start,
    output logic [2 * MATRIX_SIZE * MATRIX_SIZE * DATA_WIDTH - 1:0] sys_input_data,
    input  logic [    MATRIX_SIZE * MATRIX_SIZE * DATA_WIDTH - 1:0] sys_output_data,
    input  logic                                                    sys_valid
);

    localparam int IN_NIBBLES  = (2 * MATRIX_SIZE * MATRIX_SIZE * DATA_WIDTH) / STREAM_WIDTH; // 128 / 4 = 32
    localparam int OUT_NIBBLES = (    MATRIX_SIZE * MATRIX_SIZE * DATA_WIDTH) / STREAM_WIDTH; // 64 / 4 = 16

    typedef enum logic [2:0] {
        S_IDLE,
        S_COLLECT_IN,
        S_COMPUTE,
        S_WAIT_VALID_FALL,
        S_DRAIN_OUT
    } state_t;

    state_t     state;
    logic [5:0] count;

    logic [2 * MATRIX_SIZE * MATRIX_SIZE * DATA_WIDTH - 1:0] in_reg;
    logic [    MATRIX_SIZE * MATRIX_SIZE * DATA_WIDTH - 1:0] out_reg;
    logic                                                    sys_valid_d;

    // Detect falling edge of valid signal from systolic array
    always_ff @(posedge clk_sys or negedge rst_sys_n) begin
        if (!rst_sys_n) begin
            sys_valid_d <= 1'b0;
        end else begin
            sys_valid_d <= sys_valid;
        end
    end

    wire sys_valid_falling = sys_valid_d && !sys_valid;

    assign sys_input_data = in_reg;

    always_ff @(posedge clk_sys or negedge rst_sys_n) begin
        if (!rst_sys_n) begin
            state         <= S_IDLE;
            count         <= '0;
            in_reg        <= '0;
            out_reg       <= '0;
            sys_start     <= 1'b0;
            tx_fifo_rd_en <= 1'b0;
            rx_fifo_wr_en <= 1'b0;
            rx_fifo_din   <= '0;
        end else begin
            tx_fifo_rd_en <= 1'b0;
            rx_fifo_wr_en <= 1'b0;

            case (state)
                S_IDLE: begin
                    sys_start <= 1'b0;
                    count     <= '0;
                    // FWFT Read: tx_fifo_dout is already presenting nibble 0 when !empty
                    if (!tx_fifo_empty) begin
                        tx_fifo_rd_en <= 1'b1;
                        in_reg[(0 * STREAM_WIDTH) +: STREAM_WIDTH] <= tx_fifo_dout;
                        count <= 6'd1;
                        state <= S_COLLECT_IN;
                    end
                end

                S_COLLECT_IN: begin
                    if (!tx_fifo_empty) begin
                        tx_fifo_rd_en <= 1'b1;
                        in_reg[(count * STREAM_WIDTH) +: STREAM_WIDTH] <= tx_fifo_dout;
                        count <= count + 1'b1;

                        if (count == IN_NIBBLES - 1) begin
                            tx_fifo_rd_en <= 1'b0;
                            sys_start     <= 1'b1; // pulse for exactly one cycle
                            state         <= S_COMPUTE;
                        end
                    end
                end

                S_COMPUTE: begin
                    sys_start <= 1'b0; 
                    if (sys_valid) begin
                        state <= S_WAIT_VALID_FALL;
                    end
                end

                S_WAIT_VALID_FALL: begin
                    if (sys_valid_falling) begin
                        sys_start <= 1'b0;             // Reset computation loop
                        out_reg   <= sys_output_data;  // Capture full output matrix
                        count     <= '0;
                        state     <= S_DRAIN_OUT;
                    end
                end

                S_DRAIN_OUT: begin
                    sys_start <= 1'b0;
                    if (!rx_fifo_full) begin
                        rx_fifo_wr_en <= 1'b1;
                        rx_fifo_din   <= out_reg[(count * STREAM_WIDTH) +: STREAM_WIDTH];
                        count         <= count + 1'b1;

                        if (count == OUT_NIBBLES - 1) begin
                            state <= S_IDLE;
                        end
                    end
                end

                default: state <= S_IDLE;
            endcase
        end
    end

endmodule
