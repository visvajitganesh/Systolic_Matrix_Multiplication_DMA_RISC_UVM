    $RTL_DIR/async_fifo.sv \
    $RTL_DIR/input_fifo.sv \
    $RTL_DIR/output_fifo.sv \
    $RTL_DIR/accel_fifo.sv \
    $RTL_DIR/dma_bram.sv \
    $RTL_DIR/system_top.sv \
]
