foreach_in_collection c [get_cells -hier] {
    set n [get_object_name $c]

    if {[catch {set b [get_attribute $c bbox]}]} {
        continue
    }

    set x1 [lindex [lindex $b 0] 0]
    set y1 [lindex [lindex $b 0] 1]
    set x2 [lindex [lindex $b 1] 0]
    set y2 [lindex [lindex $b 1] 1]

    set w [expr {$x2-$x1}]
    set h [expr {$y2-$y1}]
    set area [expr {$w*$h}]

    if {$area > 100} {
        set r [get_attribute $c ref_name]
        echo "$n | $r | W=$w H=$h AREA=$area"
    }
}
