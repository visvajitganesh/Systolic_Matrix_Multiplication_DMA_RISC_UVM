# ==============================================================================
# 6. Post-Synthesis Reports
# ==============================================================================
# QoR snapshot (WNS/TNS/violating path count) first, then constraint
# violations, then detailed timing (worst path, then per-domain and
# per-path-group breakdowns), then min-delay (hold) checks, then area
# and power. Every report is redirected to its own file under
# $REPORTS_DIR so results survive independent of the session log.
redirect $REPORTS_DIR/qor.rpt { report_qor }
redirect $REPORTS_DIR/constraint_violators.rpt { report_constraint -all_violators }
# Worst setup path, full detail
redirect $REPORTS_DIR/timing_worst_setup.rpt {
    report_timing -delay_type max -max_paths 1 -path_type full_clock
}
# Worst N setup paths within each clock's own domain, so you can see
# margin across many endpoints, not just the single worst
redirect $REPORTS_DIR/timing_setup_clk_sys.rpt {
    report_timing -delay_type max -max_paths 10 -from [get_clocks clk_sys]   -to [get_clocks clk_sys]   -sort_by slack
}
redirect $REPORTS_DIR/timing_setup_clk_accel.rpt {
    report_timing -delay_type max -max_paths 10 -from [get_clocks clk_accel] -to [get_clocks clk_accel] -sort_by slack
}
# Worst hold paths, same breakdown
redirect $REPORTS_DIR/timing_hold_clk_sys.rpt {
    report_timing -delay_type min -max_paths 10 -from [get_clocks clk_sys]   -to [get_clocks clk_sys]   -sort_by slack
}
redirect $REPORTS_DIR/timing_hold_clk_accel.rpt {
    report_timing -delay_type min -max_paths 10 -from [get_clocks clk_accel] -to [get_clocks clk_accel] -sort_by slack
}
redirect $REPORTS_DIR/area.rpt { report_area }
# Pre-layout power estimate only (ideal clock network, no real switching
# activity applied) -- NOT signoff. Real leakage/dynamic power signoff
# needs PrimePower/PT-PX post-route with extracted parasitics and real
# activity vectors, at the library's worst-case leakage corner.
redirect $REPORTS_DIR/power.rpt { report_power -analysis_effort high }
# ==============================================================================
# 7. Write Outputs for Handoff to Physical Design
# ==============================================================================
# Gate-level netlist -- the primary P&R input -- goes in netlist/.
write -format verilog -hierarchy -output $NETLIST_DIR/${DESIGN_NAME}_syn.v
Writing verilog file '/home/DVLSI10/pd_group7/netlist/system_top_syn.v'.
Warning: Verilog 'assign' or 'tran' statements are written out. (VO-4)
1
# DC-specific synthesis artifacts go in results/:
#  - mapped SDC: constraints as actually applied by DC (including anything
#    DC auto-derived), not just what was typed in the source SDC. This,
#    not the original SDC, is what P&R should consume alongside the
#    netlist above.
#  - DDC: DC's own binary design database, lets this exact compiled state
#    be reopened in DC later without re-running synthesis. Not portable
#    to other tools.
write_sdc $RESULTS_DIR/${DESIGN_NAME}.mapped.sdc
1
write -format ddc -hierarchy -output $RESULTS_DIR/${DESIGN_NAME}.ddc
Writing ddc file '/home/DVLSI10/pd_group7/results/system_top.ddc'.
